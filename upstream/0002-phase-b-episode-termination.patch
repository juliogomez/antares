+++ b/src/vulnerability_localization_benchmark/agent.py
@@ -31,7 +31,8 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
         config: Agent config dict (max_turns, max_terminal_calls, etc.)
 
     Returns:
-        Dict with submitted_files, submitted_nothing, n_tool_calls, n_terminal_calls, trace
+        Dict with submitted_files, submitted_nothing, episode_termination, n_tool_calls,
+        n_terminal_calls, trace
     """
     from vulnerability_localization_benchmark.sandbox import exec_command, rebuild_container
 
@@ -48,6 +49,7 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
     finished = False
     container_alive = True
     consecutive_no_calls = 0
+    episode_termination = "turns_exhausted"
 
     for turn in range(max_turns):
         if finished:
@@ -57,6 +59,7 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
             assistant_msg, parsed_calls = runner.generate(conv)
         except Exception as e:
             log.error(f"API error on turn {turn}: {e}")
+            episode_termination = "api_error"
             break
 
         conv.append({"role": "assistant", "content": assistant_msg})
@@ -66,6 +69,7 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
             consecutive_no_calls += 1
             if consecutive_no_calls >= 3:
                 log.warning(f"[{container_name}] 3 consecutive turns with no tool calls, forcing stop")
+                episode_termination = "no_tool_calls"
                 break
             nudge = runner.format_tool_response(
                 "Please call one of: terminal, submit_vulnerable_files, or submit_no_vulnerability_found."
@@ -129,6 +133,7 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
                     submitted_files = []
                 submitted_nothing = False
                 finished = True
+                episode_termination = "submitted_files"
                 tool_results.append(f"Submitted {len(submitted_files)} file(s).")
                 log.info(f"  [{container_name}] SUBMIT FILES: {submitted_files}")
 
@@ -136,6 +141,7 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
                 submitted_files = []
                 submitted_nothing = True
                 finished = True
+                episode_termination = "declared_none"
                 tool_results.append("Recorded: no vulnerability found.")
                 log.info(f"  [{container_name}] SUBMIT: no vulnerability found")
 
@@ -155,6 +161,7 @@ def run_agent(runner, container_name: str, user_prompt: str, config: dict) -> di
     return {
         "submitted_files": submitted_files,
         "submitted_nothing": submitted_nothing,
+        "episode_termination": episode_termination,
         "n_tool_calls": n_tool_calls,
         "n_terminal_calls": n_terminal_calls,
         "conversation_turns": len(trace),
diff --git a/src/vulnerability_localization_benchmark/cli.py b/src/vulnerability_localization_benchmark/cli.py
