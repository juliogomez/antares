diff --git a/src/vulnerability_localization_benchmark/scoring.py b/src/vulnerability_localization_benchmark/scoring.py
index 114cd33..0fb5857 100644
--- a/src/vulnerability_localization_benchmark/scoring.py
+++ b/src/vulnerability_localization_benchmark/scoring.py
@@ -67,9 +67,15 @@ def aggregate_scores(results: list[dict], phase: str) -> dict:
         }
     elif phase == "b":
         tns = [r["true_negative"] for r in results]
+        terminations = [r.get("episode_termination", "unknown") for r in results]
+        termination_counts = {k: terminations.count(k) for k in sorted(set(terminations))}
+        deliberate = sum(1 for t in terminations if t == "declared_none")
+        n = len(results)
         return {
-            "true_negative_rate": round(sum(tns) / len(tns), 4),
-            "false_positive_rate": round(1 - sum(tns) / len(tns), 4),
-            "n_entries": len(results),
+            "true_negative_rate": round(sum(tns) / n, 4),
+            "false_positive_rate": round(1 - sum(tns) / n, 4),
+            "deliberate_true_negative_rate": round(deliberate / n, 4),
+            "termination_counts": termination_counts,
+            "n_entries": n,
         }
     return {}
diff --git a/tests/test_episode_termination.py b/tests/test_episode_termination.py
