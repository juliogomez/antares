--- /dev/null
+++ b/tests/test_episode_termination.py
@@ -0,0 +1,101 @@
+# Copyright 2026 Cisco Systems, Inc. and its affiliates
+#
+# SPDX-License-Identifier: Apache-2.0
+
+"""Tests for episode_termination labelling and Phase B aggregate breakdown."""
+
+import unittest
+from unittest.mock import patch
+
+from vulnerability_localization_benchmark.agent import run_agent
+from vulnerability_localization_benchmark.scoring import aggregate_scores, score_phase_b
+
+
+class FakeRunner:
+    """Minimal runner stub for agent-loop tests."""
+
+    def __init__(self, steps):
+        self.steps = list(steps)
+
+    def init_conversation(self, user_prompt):
+        return [{"role": "user", "content": user_prompt}]
+
+    def generate(self, conv):
+        if not self.steps:
+            return "", []
+        return self.steps.pop(0)
+
+    def format_tool_response(self, content, **kwargs):
+        return {"role": "tool", "content": content}
+
+
+class TestEpisodeTermination(unittest.TestCase):
+    def test_declared_none(self):
+        runner = FakeRunner([
+            ("", [{"name": "submit_no_vulnerability_found", "arguments": {}}]),
+        ])
+        result = run_agent(runner, "c_test", "prompt", {"max_turns": 5, "max_terminal_calls": 15})
+        self.assertEqual(result["episode_termination"], "declared_none")
+        self.assertTrue(result["submitted_nothing"])
+
+    def test_submitted_files(self):
+        runner = FakeRunner([
+            ("", [{"name": "submit_vulnerable_files", "arguments": {"ranked_files": ["a.py"]}}]),
+        ])
+        result = run_agent(runner, "c_test", "prompt", {"max_turns": 5, "max_terminal_calls": 15})
+        self.assertEqual(result["episode_termination"], "submitted_files")
+        self.assertFalse(result["submitted_nothing"])
+        self.assertEqual(result["submitted_files"], ["a.py"])
+
+    def test_no_tool_calls(self):
+        runner = FakeRunner([
+            ("thinking", []),
+            ("still nothing", []),
+            ("again", []),
+        ])
+        result = run_agent(runner, "c_test", "prompt", {"max_turns": 20, "max_terminal_calls": 15})
+        self.assertEqual(result["episode_termination"], "no_tool_calls")
+        self.assertTrue(result["submitted_nothing"])
+
+    def test_api_error(self):
+        class ErrorRunner(FakeRunner):
+            def generate(self, conv):
+                raise RuntimeError("timeout")
+
+        result = run_agent(ErrorRunner([]), "c_test", "prompt", {"max_turns": 5, "max_terminal_calls": 15})
+        self.assertEqual(result["episode_termination"], "api_error")
+        self.assertTrue(result["submitted_nothing"])
+
+    def test_turns_exhausted(self):
+        runner = FakeRunner([
+            ("", [{"name": "terminal", "arguments": {"command": "ls"}}]),
+        ] * 25)
+        with patch("vulnerability_localization_benchmark.sandbox.exec_command", return_value="ok"):
+            result = run_agent(runner, "c_test", "prompt", {"max_turns": 3, "max_terminal_calls": 15})
+        self.assertEqual(result["episode_termination"], "turns_exhausted")
+        self.assertTrue(result["submitted_nothing"])
+
+
+class TestPhaseBAggregate(unittest.TestCase):
+    def test_termination_breakdown(self):
+        results = [
+            {"true_negative": True, "episode_termination": "declared_none"},
+            {"true_negative": True, "episode_termination": "no_tool_calls"},
+            {"true_negative": False, "episode_termination": "submitted_files"},
+            {"true_negative": True, "episode_termination": "api_error"},
+        ]
+        agg = aggregate_scores(results, "b")
+        self.assertEqual(agg["true_negative_rate"], 0.75)
+        self.assertEqual(agg["deliberate_true_negative_rate"], 0.25)
+        self.assertEqual(agg["termination_counts"]["api_error"], 1)
+        self.assertEqual(agg["termination_counts"]["declared_none"], 1)
+        self.assertEqual(agg["termination_counts"]["no_tool_calls"], 1)
+        self.assertEqual(agg["termination_counts"]["submitted_files"], 1)
+
+    def test_score_phase_b_unchanged(self):
+        scores = score_phase_b([], submitted_nothing=True)
+        self.assertTrue(scores["true_negative"])
+
+
+if __name__ == "__main__":
+    unittest.main()
